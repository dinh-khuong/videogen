# ===== LLM (DeepSeek) =====
# Lấy tại: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Mô hình cho Đạo diễn AI (phải hỗ trợ gọi công cụ/function calling). Bỏ trống: dùng DEEPSEEK_MODEL
# DIRECTOR_MODEL=deepseek-chat

# ===== Nguồn ảnh =====
# Dùng theo thứ tự này (bỏ qua nguồn chưa có key); nguồn lỗi sẽ tự chuyển sang nguồn sau.
# Trong form tạo video có thể chọn "Công cụ tìm ảnh" (Brave, Google...) để ưu tiên một nguồn cho từng video.
IMAGE_PROVIDERS=duckduckgo,google,brave,serper,pexels,pixabay

# --- DuckDuckGo: không cần key ---
# Vùng tìm kiếm: wt-wt (toàn cầu), vn-vi (Việt Nam), us-en ...
DDG_REGION=wt-wt
# Lọc giấy phép ảnh (để trống = không lọc). Làm quảng cáo nên dùng ShareCommercially hoặc ModifyCommercially.
DDG_LICENSE=

# --- Google Custom Search ---
# 1. Bật "Custom Search API": https://console.cloud.google.com/apis/library/customsearch.googleapis.com
# 2. Tạo API key (dạng AIza...): https://console.cloud.google.com/apis/credentials -> "Create credentials" -> "API key"
#    (File client_secret OAuth KHÔNG dùng được cho API này.)
# 3. Tạo search engine, bật "Search the entire web" + "Image search", copy "Search engine ID":
#    https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# --- Serper.dev: kết quả Google Images qua API, dùng nếu Google chặn project mới ---
SERPER_API_KEY=your_serper_api_key_here

# --- Brave Search: tìm ảnh bằng Brave Search API (có gói miễn phí) ---
# Lấy key tại: https://api-dashboard.search.brave.com (đăng ký gói, rồi "API Keys")
BRAVE_API_KEY=your_brave_api_key_here
# Quốc gia ưu tiên kết quả (mã 2 chữ, vd VN, US). Để trống = Brave tự chọn
# BRAVE_COUNTRY=

# --- Pexels: ảnh miễn phí, được dùng thương mại (an toàn cho quảng cáo) ---
PEXELS_API_KEY=your_pexels_api_key_here
# --- Pixabay: dùng chung PIXABAY_API_KEY ở phần video bên dưới (ảnh + clip, được dùng thương mại) ---

# ===== Nguồn clip video trên mạng =====
# Chỉ lấy video được phép dùng lại; nguồn tự ghi công vào mô tả video. Dùng theo thứ tự, bỏ qua nguồn chưa có key.
VIDEO_PROVIDERS=pexels,pixabay,wikimedia,youtube
# Độ dài mỗi clip lấy về (giây). Mỗi bước ghép nhiều clip nối tiếp (chọn trong form, mặc định 3)
WEB_CLIP_SECONDS=10
# --- Pexels Videos: dùng chung PEXELS_API_KEY ở trên ---
# --- Pixabay Videos (miễn phí, dùng thương mại): https://pixabay.com/api/docs/ ---
PIXABAY_API_KEY=your_pixabay_api_key_here
# --- Wikimedia Commons: không cần key. Nên điền URL/email liên hệ (chính sách User-Agent của Wikimedia) ---
# WIKIMEDIA_CONTACT=
# --- YouTube: chỉ video giấy phép Creative Commons. Tìm bằng YouTube Data API v3
#     (bật tại https://console.cloud.google.com/apis/library/youtube.googleapis.com), không có thì dùng GOOGLE_API_KEY.
#     Tải bằng yt-dlp; YouTube có thể chặn tải (yêu cầu đăng nhập) -> nguồn này tự bỏ qua. ---
# YOUTUBE_API_KEY=

# ===== TTS =====
# Dùng edge-tts (miễn phí, không cần API key). Có thể đổi giọng qua TTS_VOICE.
# Danh sách giọng: chạy `edge-tts --list-voices`
# Giọng có chữ Multilingual (vd en-US-AvaMultilingualNeural) đọc được nhiều ngôn ngữ, kể cả tiếng Việt
TTS_VOICE=vi-VN-HoaiMyNeural
# Tốc độ đọc, ví dụ +10% (nhanh hơn) hoặc -10% (chậm hơn)
TTS_RATE=+0%
# Giọng khác: gtts:vi ("chị Google", miễn phí) hoặc fpt:<giọng> (FPT.AI, giọng Việt tự nhiên:
# banmaiace, thuminh, leminh, myan, ngoclam, giahuy, lannhi, linhsan, minhquang). Lấy key tại https://console.fpt.ai
# FPT_AI_API_KEY=

# ===== Font phụ đề (tùy chọn) =====
# Mặc định tự tìm Noto Sans / DejaVu Sans / Arial. Chỉ định nếu chữ tiếng Việt bị lỗi.
# FONT_PATH=/path/to/font.ttf

# ===== Phân tích asset (đọc chữ + AI tóm tắt) =====
# OCR chạy local bằng Tesseract. Cài: sudo dnf install tesseract tesseract-langpack-vie (Fedora)
#                                     sudo apt install tesseract-ocr tesseract-ocr-vie (Ubuntu)
# TESSERACT_CMD=tesseract
# Ngôn ngữ OCR (gói ngôn ngữ phải được cài), nối bằng dấu +
OCR_LANGS=vie+eng

# Mô hình thị giác (tùy chọn) để AI "nhìn" được ảnh không có chữ. Dùng API kiểu OpenAI, ví dụ:
#   Gemini:  VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  VISION_MODEL=gemini-2.5-flash
#   OpenAI:  VISION_BASE_URL=https://api.openai.com/v1  VISION_MODEL=gpt-4o-mini
#   Ollama (chạy local, không cần key): VISION_BASE_URL=http://localhost:11434/v1  VISION_MODEL=qwen2.5vl
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=
